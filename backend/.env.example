# --- Application ---
APP_NAME="Intel-AI Backend"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated, or *) ---
CORS_ORIGINS=*

# --- Database (PostgreSQL, async asyncpg driver) ---
DB_USER=intelai
DB_PASSWORD=intelai
DB_NAME=intelai
DB_HOST=localhost
DB_PORT=5432
DB_ECHO=false

# Optional: set a full URL to override the individual parts above.
# DATABASE_URL=postgresql+asyncpg://intelai:intelai@localhost:5432/intelai
