# --- Application ---
APP_NAME="Intel-AI Backend"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated, or *) ---
CORS_ORIGINS=*

# --- Database (PostgreSQL, async asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intel_ai
DB_ECHO=false
