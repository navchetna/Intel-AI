# Public API base URL used by the browser/SSR fetch layer.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8040

# Single configurable URL prefix for every route, page and static asset.
# Defaults to "/intel-ai". Set to "" for local development (served at the root).
# When set, the reverse proxy must forward the prefix WITHOUT stripping it.
# NEXT_PUBLIC_BASE_PATH="/intel-ai"
